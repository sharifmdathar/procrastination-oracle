# Copy to .env and fill in what you have. Every value is optional for the
# synthetic demo: `scripts/generate_synthetic.py` + `scripts/run_nightly.py`
# work with none of these set.

# Todoist (only needed for `scripts/ingest_todoist.py`)
TODOIST_API_TOKEN=

# Local LLM served by Ollama. `ollama pull qwen3`
OLLAMA_MODEL=qwen3
OLLAMA_HOST=http://localhost:11434
# qwen3 is a reasoning model: thinking is off by default so the whole token
# budget is not spent on  thinking (which returned empty answers). Set 1 to
# re-enable; it is several times slower and rarely improves these short tasks.
OLLAMA_THINK=0

# TabPFN-3.5 weights are license-gated. Accept the license once at
# https://ux.priorlabs.ai (Licenses tab -> TabPFN-3.5), copy the API key from
# the account page, and put it here. A key alone is not enough: the run fails
# with an explicit "license not accepted" message until the license is accepted.
# Required only for the *first* download; afterwards the model cache is reused
# and the app runs fully offline.
TABPFN_TOKEN=
# Only needed if https://huggingface.co/Prior-Labs/tabpfn_3_5 is gated for you.
# Accept the terms there, then create a read token at /settings/tokens.
HF_TOKEN=
# "cpu" (default) or "cuda" / "auto".
TABPFN_DEVICE=cpu

# Optional: location of the SQLite event log (defaults to ./oracle.db)
ORACLE_DB=oracle.db
# Optional: fitted model path (defaults to models/oracle_tabpfn_v3_5.joblib)
ORACLE_MODEL=models/oracle_tabpfn_v3_5.joblib

# Temporal (optional). Cron uses this timezone; default is UTC.
ORACLE_TZ=UTC
TEMPORAL_ADDRESS=localhost:7233
